# Python bytecode and caches
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual environments (uv creates .venv)
.venv/

# Build and packaging artefacts, inside each package folder. Anchored, so that the top-level build/ folder is tracked.
/*/build/
/*/dist/
*.egg-info/

# Nextflow run state and outputs
.nextflow/
.nextflow.log*
work/
results/

# Nextflow site configs, generated from a Pulumi stack's outputs by infra/nextflow_site_config.py.
*.site.config

# Test coverage
.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Local environment and secrets
.env
.env.*

# macOS
.DS_Store
