// Runs every process on Google Cloud Batch, one short-lived VM per task. Project, location, work directory, network,
// service account, the DRAGEN image and the licence secret come from a deployment's site config, which
// infra/nextflow_site_config.py generates from the Pulumi stack's outputs, passed with -c.

// Pinned like Nextflow itself: the release that shipped with 26.10.2.
plugins {
    id 'nf-google@1.29.1'
}

process {
    executor = 'google-batch'
    // Chosen explicitly: Nextflow's own choice by cpus and memory goes through a deprecated service. E2 is the most
    // widely available family, which matters more than price for these small tasks.
    machineType = 'e2-standard-2'
    withLabel: dragen {
        // AMD, as Illumina recommends for Software Mode. n4d would need Hyperdisk boot disks.
        machineType = 'n2d-highmem-8'
        // Mounted at /tmp, where DRAGEN writes its intermediate files and the licence key goes.
        disk = [request: 375.GB, type: 'local-ssd']
    }
}

google {
    batch {
        // Standard VMs: spot capacity for a machine type can run out in a zone, and a task then waits indefinitely. On
        // regional runs the saving is cents; revisit for whole genomes, together with retries across machine types.
        spot = false
        // DRAGEN checks its licence over the internet on every run, so VMs need outbound access. Point
        // google.batch.network at a network without inbound firewall rules.
        usePrivateAddress = false
    }
}
