manifest {
    name = 'rare-disease-benchmark-build'
    nextflowVersion = '!>=26.10.2'
}

// A Seqera launch can only set it through params; without one, outputs go to results/ under the launch directory.
outputDir = params.output_dir ?: 'results'

// Pinned like Nextflow itself: the release that shipped with 26.10.2.
plugins {
    id 'nf-google@1.29.1'
}

// Everything here applies however the pipeline is launched. Seqera supplies the executor, project, region, service
// account and work directory itself and selects no profile, so nothing a Seqera run needs may live in a profile; values
// that differ between deployments come in as params (infra/pipeline_config.py writes them).
process {
    // Chosen explicitly: Nextflow's own choice by cpus and memory goes through a deprecated service. E2 is the most
    // widely available family, which matters more than price for these small tasks.
    machineType = 'e2-standard-2'
    withLabel: dragen {
        container = params.dragen_container
        cpus = 16
        // Below the 128 GB of a 16-vCPU highmem VM, which cannot all be allocated to a task. Memory is set by the reference,
        // not the input: on 64 GB, DRAGEN ran out on a few megabases of reads, having sized its sort buffers for a genome.
        memory = 120.GB
        // AMD, as Illumina recommends for Software Mode, with the 128 GB Illumina recommends even for panels and low-pass
        // genomes. n4d would need Hyperdisk boot disks.
        machineType = 'n2d-highmem-16'
        // Mounted at /tmp, where DRAGEN writes its intermediate files and the licence key goes.
        disk = [request: 375.GB, type: 'local-ssd']
        // The runtime arguments DRAGEN requires inside a container, with nproc raised to the Software Mode minimum.
        containerOptions = '--pid host --ulimit nofile=720000:720000 --ulimit nproc=65535:65535 -v /dev/shm:/dev/shm:rw'
    }
}

google {
    batch {
        // Standard VMs: spot capacity for a machine type can run out in a zone, and a task then waits indefinitely. A
        // Seqera compute environment that sets spot overrides this, so a reclaimed task is also retried.
        spot = false
        maxSpotAttempts = 3
        // DRAGEN checks its licence over the internet on every run, so VMs need outbound access.
        usePrivateAddress = false
    }
}

profiles {
    // Launching from a workstation rather than Seqera; the deployment's site config adds project, region, network,
    // service account and work directory.
    google {
        process.executor = 'google-batch'
    }
    // For -stub-run on a small machine such as a CI runner: the local executor rejects a task that asks for more than
    // the machine has.
    stub {
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
}
