manifest {
    name = 'rare-disease-benchmark-build'
    nextflowVersion = '!>=26.10.2'
}

outputDir = 'results'

process {
    withLabel: dragen {
        cpus = 16
        // Below the 128 GB of a 16-vCPU highmem VM, which cannot all be allocated to a task. Memory is set by the reference,
        // not the input: on 64 GB, DRAGEN ran out on a few megabases of reads, having sized its sort buffers for a genome.
        memory = 120.GB
        // The runtime arguments DRAGEN requires inside a container, with nproc raised to the Software Mode minimum.
        containerOptions = '--pid host --ulimit nofile=720000:720000 --ulimit nproc=65535:65535 -v /dev/shm:/dev/shm:rw'
    }
}

profiles {
    google {
        includeConfig 'conf/google.config'
    }
    // For -stub-run on a small machine such as a CI runner: the local executor rejects a task that asks for more than
    // the machine has.
    stub {
        process.resourceLimits = [cpus: 2, memory: 4.GB]
    }
}
